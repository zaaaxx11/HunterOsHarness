# Copy to /etc/hunter-gateway.env, then: chmod 600 /etc/hunter-gateway.env
# NEVER commit the populated file — deploy/.gitignore excludes it.

# Telegram transport
HUNTEROS_TELEGRAM_TOKEN=
HUNTEROS_TELEGRAM_ALLOWED_USERS=

# Devora / LLM provider key (same key the harness reads from ~/.hunter/keys.env)
DEVORA_API_KEY=

# Optional — enable only the transports you actually use.
# HUNTEROS_DISCORD_TOKEN=
# HUNTEROS_DISCORD_ALLOWED_USERS=
# HUNTEROS_WEBHOOK_SECRET=
# HUNTEROS_WEBHOOK_PORT=
# HUNTEROS_CONFIG=
